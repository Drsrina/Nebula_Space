# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEBULA_TOKEN: Secret Bearer token for authenticating HTTP filesystem operations.
# Required in production. In development, open access is allowed if left unset.
NEBULA_TOKEN=

# NEBULA_ROOTS: Comma-separated list of permitted filesystem root paths for isolation.
# Path traversal protection prevents access outside these directories.
# Example: /data,/mnt/storage
NEBULA_ROOTS=/data

# NEBULA_READONLY: Set to "true" to lock the filesystem into read-only mode.
NEBULA_READONLY=false
